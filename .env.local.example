# Google Gemini API key (extraction, scoring, drafting)
GEMINI_API_KEY=

# Neon Postgres — direct connection string (Connect button in the Neon console,
# use the pooled "-pooler" host). Run db/schema.sql against it first.
DATABASE_URL=

# Vercel Blob (CV file storage) — https://vercel.com/docs/storage/vercel-blob
# If unset, uploaded CVs fall back to local disk storage under public/uploads
# for local development only (see lib/blob.ts).
BLOB_READ_WRITE_TOKEN=

# Resend (outbound email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kargo Hiring <hiring@yourdomain.com>
